{
  "tasks": {
    "run": "UR_DEBUG=1 deno run -S --allow-env=FORCE_COLOR,UR_DEBUG --allow-read --allow-net --unstable-worker-options --v8-flags=--max-old-space-size=12000 --watch ./src/Main.ts",
    "data": "deno run --env --allow-env=API_KEY,API_SECRET,NODE_EXTRA_CA_CERTS,FORCE_COLOR -RWN --allow-sys=osRelease ./scripts/RequestCards.ts",
    "check": "deno check src/ tests/ scripts/ log_server.ts",
    "compile": "deno run -RW ./scripts/CompileAbilities.js",
    "log": "deno run --watch --allow-net=0.0.0.0:8787,127.0.0.1:8788 --allow-read=captures,data,ur-logger.user.js --allow-write=ur_log.jsonl,captures,data --allow-env=FORCE_COLOR --allow-sys=osRelease ./log_server.ts",
    "cards": "deno run --allow-read --allow-write=data --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/BuildCardData.ts",
    "opening-prior": "deno run --allow-read=captures,src/solver/Search.ts,rust/src/advisor/search.rs --allow-write=src/solver/Search.ts,rust/src/advisor/search.rs ./scripts/OpeningPrior.ts",
    "prune": "deno run --allow-read --allow-write --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/PruneLog.ts",
    "deck-data": "deno run --allow-read --allow-write=data --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/DeckData.ts",
    "decks": "deno run --allow-net=127.0.0.1:8788 --allow-read=data,src/decks/ui,captures/games --allow-env=FORCE_COLOR --allow-sys=osRelease ./src/decks/Service.ts",
    "matchup": "deno run --allow-read=data,captures,rust,cache --allow-write=cache --allow-run=rust/target/release/urban-recreation-matchup.exe,rust/target/release/urban-recreation-matchup --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/Matchup.ts",
    "card-coverage": "deno run --allow-read=data,captures,rust --allow-write=data/card_coverage.json --allow-run=rust/target/release/urban-recreation-matchup.exe,rust/target/release/urban-recreation-matchup --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/CardCoverage.ts",
    "extract": "deno run --allow-read --allow-write=captures --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/ExtractBattle.ts",
    "bench": "deno run --allow-env=FORCE_COLOR --allow-read --allow-sys=osRelease --unstable-worker-options --v8-flags=--max-old-space-size=12000 --inspect-brk ./tests/IterTree.bench.ts",
    "advise": "deno run --allow-read --allow-net=localhost:8787,127.0.0.1:8787 --allow-run=deno,rust/target/release/urban-recreation-advisor-jsonl.exe,rust/target/release/urban-recreation-advisor-jsonl --allow-env=FORCE_COLOR --allow-sys=osRelease --v8-flags=--max-old-space-size=12000 ./src/solver/Advisor.ts",
    "time-search": "deno run --allow-env=FORCE_COLOR --allow-read --allow-sys=osRelease --v8-flags=--max-old-space-size=12000 ./tests/Search.bench.ts",
    "time-rust": "deno run --allow-read --allow-run=cargo,rust/target/release/urban-recreation-advisor-jsonl.exe,rust/target/release/urban-recreation-advisor-jsonl --allow-env=FORCE_COLOR --allow-sys=osRelease --v8-flags=--max-old-space-size=12000 ./tests/RustCompare.bench.ts",
    "time": "deno run --allow-env=FORCE_COLOR --allow-read --allow-sys=osRelease --unstable-worker-options --v8-flags=--max-old-space-size=12000 ./tests/IterTree.bench.ts",
    "rust:check": "cargo check --manifest-path rust/Cargo.toml --locked --all-features",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --locked",
    "pins:update": "UR_UPDATE_EXPECT=1 cargo test --manifest-path rust/Cargo.toml --locked && UR_UPDATE_EXPECT=1 deno test -A --no-check tests/solver/RustAdvisorInput.test.ts",
    "rust:worker:test": "deno run --allow-run=cargo,deno --allow-read --allow-env ./scripts/TestRustWorker.ts",
    "rust:worker": "cargo build --manifest-path rust/Cargo.toml --release --locked --bin urban-recreation-advisor-jsonl",
    "rust:matchup": "cargo build --manifest-path rust/Cargo.toml --release --locked --bin urban-recreation-matchup",
    "rust:advise": "cargo run --manifest-path rust/Cargo.toml --release --locked --bin urban-recreation-advisor --",
    "rust:legacy": "cargo run --manifest-path rust/Cargo.toml --locked --features legacy-advisor --bin urban-recreation-legacy"
  },
  "imports": {
    "@std/streams": "jsr:@std/streams@1",
    "hono": "jsr:@hono/hono@^4.6.14",
    "@std/assert": "jsr:@std/assert@1",
    "@types/ws": "npm:@types/ws@^8.5.13",
    "colors": "npm:colors@^1.4.0",
    "urban-rivals-oauth": "npm:urban-rivals-oauth@^2.0.1",
    "@/": "./src/",
    "@data/": "./data/",
    "ws": "npm:ws@^8.18.0"
  }
}
