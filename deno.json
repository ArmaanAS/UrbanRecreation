{
  "tasks": {
    "run": "deno run -S --allow-env=FORCE_COLOR --allow-read --allow-net --unstable-worker-options --v8-flags=--max-old-space-size=12000 --watch ./src/Main.ts",
    "data": "deno run --env --allow-env=API_KEY,API_SECRET,NODE_EXTRA_CA_CERTS,FORCE_COLOR -RWN --allow-sys=osRelease ./scripts/RequestCards.ts",
    "compile": "deno run -RW ./scripts/CompileAbilities.js",
    "log": "deno run --allow-net=0.0.0.0:8787 --allow-read=captures --allow-write=ur_log.jsonl,captures,data --allow-env=FORCE_COLOR --allow-sys=osRelease ./log_server.ts",
    "cards": "deno run --allow-read --allow-write=data --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/BuildCardData.ts",
    "extract": "deno run --allow-read --allow-write=captures --allow-env=FORCE_COLOR --allow-sys=osRelease ./scripts/ExtractBattle.ts",
    "bench": "deno run --allow-env=FORCE_COLOR --allow-read --allow-sys=osRelease --unstable-worker-options --v8-flags=--max-old-space-size=12000 --inspect-brk ./tests/IterTree.bench.ts",
    "time": "deno run --allow-env=FORCE_COLOR --allow-read --allow-sys=osRelease --unstable-worker-options --v8-flags=--max-old-space-size=12000 ./tests/IterTree.bench.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.6.14",
    "@std/assert": "jsr:@std/assert@1",
    "@types/ws": "npm:@types/ws@^8.5.13",
    "colors": "npm:colors@^1.4.0",
    "urban-rivals-oauth": "npm:urban-rivals-oauth@^2.0.1",
    "@/": "./src/",
    "@data/": "./data/",
    "ws": "npm:ws@^8.18.0"
  }
}