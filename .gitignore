.env*

tokens.json
# network capture logs (contain session tokens)
ur_log*.jsonl

# site card database dump (40MB, regenerate with __ur.dumpCharacters())
data/site_characters.jsonl

# local identity cache used to survive log-server watch restarts
captures/.player-id

# deck builder: the owner's collection and decks, and the site's full card list (large,
# regenerate by opening Collection Pro or with `deno task deck-data`)
data/site_cards.json
data/my_collection.json
data/my_decks.json
# deck builder: the undo log of every deck the UR Lab panel saved to the site (card lists
# before and after, and the site's answer)
data/deck_history.jsonl

# deck builder: solved hand pairs (keyed by engine and data provenance) and the per-card
# coverage report; both regenerate from the solver
cache/
data/card_coverage.json
# clan matrices from `deno task clan-matrix`, which Deck Lab reads
data/analysis/
# situation coverage of the capture corpus; `deno task situations` regenerates it in seconds
data/situations.json
